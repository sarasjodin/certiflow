@page "/jobs/{Id:guid}/edit"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using CertiFlowApp.Features.Jobs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject NavigationManager NavigationManager
@inject JobService JobService
@inject CustomerService CustomerService

<PageTitle>Edit job</PageTitle>

<h1>Edit job</h1>

@if (_isLoading)
{
    <p>Loading job...</p>
}
else if (_form is null)
{
    <div class="alert alert-warning" role="alert">
        Job not found.
    </div>

    <a class="btn btn-secondary" href="/jobs">
        Back to jobs
    </a>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <div class="form-container">
        <EditForm Model="_form"
                  OnValidSubmit="UpdateJobAsync"
                  FormName="edit-job">

        <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="job-customer" class="form-label">
                    Customer
                </label>

                <input id="job-customer"
                       class="form-control"
                       value="@_form.CustomerName"
                       readonly />
            </div>

            <div class="mb-3">
                <label for="job-number" class="form-label">
                    Job number
                </label>

                <InputText id="job-number"
                            class="form-control"
                            @bind-Value="_form.JobNumber" />

                <ValidationMessage For="() => _form.JobNumber" />
            </div>

            <div class="mb-3">
                <label for="job-title" class="form-label">
                    Title
                </label>

                <InputText id="job-title"
                            class="form-control"
                            @bind-Value="_form.Title" />

                <ValidationMessage For="() => _form.Title" />
            </div>

            <div class="mb-3">
                <label for="job-description" class="form-label">
                    Description
                </label>

                <InputTextArea id="job-description"
                                class="form-control"
                                @bind-Value="_form.Description" />

                <ValidationMessage For="() => _form.Description" />
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "Save changes")
                </button>

                <a class="btn btn-secondary"
                    href="@($"/jobs/{Id}")">
                    Cancel
                </a>
        </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; } // Receives the job ID from the URL route
    private EditJobForm? _form;
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _form = await JobService.GetEditFormAsync(
                Id,
                _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (Exception)
        {
            _errorMessage = "The job could not be loaded.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task UpdateJobAsync()
    {
        if (_form is null)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var updated = await JobService.UpdateAsync(
                _form,
                _componentCts.Token);

            if (!updated)
            {
                _errorMessage = "Job not found.";
                return;
            }

            NavigationManager.NavigateTo($"/jobs/{Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The job could not be updated.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}


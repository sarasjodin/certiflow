@page "/jobs"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Jobs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject JobService JobService

<PageTitle>Jobs</PageTitle>

<h1>Jobs</h1>

<p>
    <a class="btn btn-primary" href="/jobs/create">
        Create job
    </a>
</p>

@if (_isLoading)
{
    <p>Loading jobs...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_jobs.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No jobs have been created.
    </div>
}
else
{
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Job number</th>
                <th>Title</th>
                <th>Customer</th>
                <th>Measurements</th>
                <th>Job status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var job in _jobs)
            {
                <tr class="align-middle">
                    <td>@job.JobNumber</td>
                    <td>@job.Title</td>
                    <td>
                        <a href="@($"/customers/{job.CustomerId}/jobs")"
                            class="text-decoration-none"
                            aria-label="@($"View jobs for {job.CustomerName}")">
                            @job.CustomerName <span aria-hidden="true">›</span>
                        </a>
                    </td>
                    <td class="p-0 text-center">
                        <a href="@($"/jobs/{job.Id}/measurements")"
                            class="d-block p-3 text-decoration-none"
                            aria-label="@($"View {job.MeasurementCount} measurements for {job.JobNumber}")">
                            @job.MeasurementCount
                        </a>
                    </td>
                    <td>@job.Status</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/jobs/{job.Id}")">
                                Details
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="@($"/jobs/{job.Id}/edit")">
                                Edit
                            </a>

                            <a class="btn btn-sm btn-outline-danger"
                               href="@($"/jobs/{job.Id}/delete")">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

@code {
    private List<JobListItem> _jobs = [];
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            _jobs = await JobService.GetAllAsync(_componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (Exception)
        {
            _errorMessage = "The jobs could not be loaded.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}


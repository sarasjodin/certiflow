@page "/jobs/{Id:guid}"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Jobs
@using CertiFlowApp.Services.DateTime
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject JobService JobService

<PageTitle>Job details</PageTitle>

@if (_isLoading)
{
    <p>Loading job...</p>
}
else if (_job is null)
{
    <div class="alert alert-warning" role="alert">
        Job not found.
    </div>

    <a class="btn btn-secondary" href="/jobs">
        Back to jobs
    </a>
}
else
{
    <h1>@_job.Title</h1>

    <dl class="row">
        <dt class="col-sm-3">Job number</dt>
        <dd class="col-sm-9">@_job.JobNumber</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@_job.CustomerName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@_job.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@_job.Status</dd>

        <dt class="col-sm-3">Certificate number</dt>
        <dd class="col-sm-9">@_job.CertificateNumber</dd>

        <dt class="col-sm-3">Approved at</dt>
        <dd class="col-sm-9">@ApplicationDateTime.Format(_job.ApprovedAtUtc)</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@ApplicationDateTime.Format(_job.CreatedAtUtc)</dd>
        <dt class="col-sm-3">Created by</dt>
        <dd class="col-sm-9">@_job.CreatedByUserId</dd>
        <dt class="col-sm-3">Last updated</dt>
        <dd class="col-sm-9">@ApplicationDateTime.Format(_job.UpdatedAtUtc)</dd>
        <dt class="col-sm-3">Last updated by</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(_job.UpdatedByUserId))
            {
                @_job.UpdatedByUserId
            }
            else
            {
                <span>-</span>
            }
        </dd>
        <dt class="col-sm-3">Measurements</dt>
        <dd class="col-sm-9">@_job.MeasurementCount</dd>
    </dl>

    <a class="btn btn-primary"
       href="@($"/jobs/{_job.Id}/edit")">
        Edit
    </a>

    <a class="btn btn-danger"
       href="@($"/jobs/{_job.Id}/delete")">
        Delete
    </a>

    <a class="btn btn-secondary" href="/jobs">
        Back to jobs
    </a>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private JobDetailsModel? _job; // Job details model to hold the job information
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _job = await JobService.GetByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }
}

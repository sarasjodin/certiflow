@page "/tools/{Id:guid}/delete"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Tools
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject ToolService ToolService
@inject NavigationManager NavigationManager

<PageTitle>Delete tool</PageTitle>

@if (_isLoading)
{
    <p>Loading tool...</p>
}
else if (_tool is null)
{
    <div class="alert alert-warning" role="alert">
        Tool not found.
    </div>

    <a class="btn btn-secondary" href="/tools">
        Back to tools
    </a>
}
else
{
    <h1>Delete tool</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    @if (_tool.MeasurementCount > 0)
    {
        <div class="alert alert-info" role="alert">
            This tool cannot be deleted because it has related measurements.
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Are you sure you want to delete this tool?
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Tool</dt>
        <dd class="col-sm-9">@_tool.Name</dd>

        <dt class="col-sm-3">Serial number</dt>
        <dd class="col-sm-9">@_tool.SerialNumber</dd>

        <dt class="col-sm-3">Tool type</dt>
        <dd class="col-sm-9">@_tool.ToolType</dd>

        <dt class="col-sm-3">Calibration valid until</dt>
        <dd class="col-sm-9">
            @if (_tool.CalibrationValidUntil.HasValue)
            {
                @_tool.CalibrationValidUntil.Value.ToString("yyyy-MM-dd")
            }
            else
            {
                <span>Not specified</span>
            }
        </dd>

        <dt class="col-sm-3">Is active</dt>
        <dd class="col-sm-9">@_tool.IsActive</dd>

        <dt class="col-sm-3">Related measurements</dt>
        <dd class="col-sm-9">@_tool.MeasurementCount</dd>
    </dl>

    <div class="d-flex gap-2">

        @if (_tool.MeasurementCount == 0)
        {
            <button type="button"
                    class="btn btn-danger"
                    disabled="@_isDeleting"
                    @onclick="DeleteToolAsync">
                @(_isDeleting ? "Deleting..." : "Delete")
            </button>
        }

        <a class="btn btn-secondary"
           href="@($"/tools/{Id}")">
            Cancel
        </a>
    </div>
    }

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ToolDetailsModel? _tool;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _tool = await ToolService.GetByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteToolAsync()
    {
        _isDeleting = true;
        _errorMessage = null;

        try
        {
            var deleted = await ToolService.DeleteAsync(Id);

            if (!deleted)
            {
                _errorMessage = "Tool not found.";
                return;
            }

            NavigationManager.NavigateTo("/tools");
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The tool could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
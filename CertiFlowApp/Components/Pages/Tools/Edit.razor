@page "/tools/{Id:guid}/edit"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Tools
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject ToolService ToolService
@inject NavigationManager NavigationManager

<PageTitle>Edit tool</PageTitle>

@if (_isLoading)
{
    <p>Loading tool...</p>
}
else if (_form is null)
{
    <div class="alert alert-warning" role="alert">
        Tool not found.
    </div>

    <a class="btn btn-secondary" href="/tools">
        Back to tools
    </a>
}
else
{
    <h1>Edit tool</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <EditForm Model="_form"
              OnValidSubmit="UpdateToolAsync"
              FormName="edit-tool">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="tool-name" class="form-label">
                Tool name
            </label>

            <InputText id="tool-name"
                       class="form-control"
                       @bind-Value="_form.Name" />

            <ValidationMessage For="() => _form.Name" />
        </div>

        <div class="mb-3">
            <label for="tool-serial-number" class="form-label">
                Serial number
            </label>

            <InputText id="tool-serial-number"
                       class="form-control"
                       @bind-Value="_form.SerialNumber" />

            <ValidationMessage For="() => _form.SerialNumber" />
        </div>

        <div class="mb-3">
            <label for="tool-type" class="form-label">
                Tool type
            </label>

            <InputText id="tool-type"
                       class="form-control"
                       @bind-Value="_form.ToolType" />

            <ValidationMessage For="() => _form.ToolType" />
        </div>

        <div class="mb-3">
            <label for="tool-calibration-valid-until"
                   class="form-label">
                Calibration valid until
            </label>

            <InputDate id="tool-calibration-valid-until"
                       class="form-control"
                       @bind-Value="_form.CalibrationValidUntil" />

            <ValidationMessage For="() => _form.CalibrationValidUntil" />
        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isSaving">
                @(_isSaving ? "Saving..." : "Save changes")
            </button>

            <a class="btn btn-secondary"
               href="@($"/tools/{Id}")">
                Cancel
            </a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }  // Receives the tool ID from the URL route
    private EditToolForm? _form;
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _form = await ToolService.GetEditFormAsync(Id, _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task UpdateToolAsync()
    {
        if (_form is null)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var updated = await ToolService.UpdateAsync(_form, _componentCts.Token);

            if (!updated)
            {
                _errorMessage = "Tool not found.";
                return;
            }

            NavigationManager.NavigateTo($"/tools/{Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The tool could not be updated.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

@page "/measurements/{Id:guid}/delete"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Measurements
@using Microsoft.AspNetCore.Authorization
@using CertiFlowApp.Services.DateTime
@attribute [Authorize]
@inject MeasurementService MeasurementService
@inject NavigationManager NavigationManager

<PageTitle>Delete measurement</PageTitle>

@if (_isLoading)
{
    <p>Loading measurement...</p>
}
else if (_measurement is null)
{
    <div class="alert alert-warning" role="alert">
        Measurement not found.
    </div>

    <a class="btn btn-secondary" href="/measurements">
        Back to measurements
    </a>
}
else
{
    <h1>Delete measurement</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this measurement?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Job number</dt>
        <dd class="col-sm-9">@_measurement.JobNumber</dd>

        <dt class="col-sm-3">Tool</dt>
        <dd class="col-sm-9">
            @_measurement.ToolName - @_measurement.ToolSerialNumber
        </dd>

        <dt class="col-sm-3">Value</dt>
        <dd class="col-sm-9">
            @_measurement.Value @_measurement.Unit
        </dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@_measurement.Status</dd>

        <dt class="col-sm-3">Measured at</dt>
        <dd class="col-sm-9">
            @ApplicationDateTime.Format(_measurement.MeasuredAtUtc)
        </dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(_measurement.Notes))
            {
                @_measurement.Notes
            }
            else
            {
                <span>-</span>
            }
        </dd>
    </dl>

    <div class="d-flex gap-2">

        <button type="button"
                class="btn btn-danger"
                disabled="@_isDeleting"
                @onclick="DeleteMeasurementAsync">
            @(_isDeleting ? "Deleting..." : "Delete")
        </button>

        <a class="btn btn-secondary"
           href="@($"/measurements/{Id}")">
            Cancel
        </a>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private MeasurementDetailsModel? _measurement; // Measurement details model to hold the measurement information
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _measurement = await MeasurementService.GetByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteMeasurementAsync()
    {
        _isDeleting = true;
        _errorMessage = null;

        try
        {
            var deleted = await MeasurementService.DeleteAsync(Id);

            if (!deleted)
            {
                _errorMessage = "Measurement not found.";
                return;
            }

            NavigationManager.NavigateTo("/measurements");
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The measurement could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}


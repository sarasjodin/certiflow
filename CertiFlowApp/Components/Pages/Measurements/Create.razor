@page "/measurements/create"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Jobs
@using CertiFlowApp.Features.Tools
@using CertiFlowApp.Features.Measurements
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject NavigationManager NavigationManager
@inject JobService JobService
@inject ToolService ToolService
@inject MeasurementService MeasurementService

<PageTitle>Create measurement</PageTitle>

<h1>Create measurement</h1>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

@if (_isLoading)
{
    <div class="alert alert-info" role="alert">
        Loading jobs and tools...
    </div>
}
else if (_jobs.Count == 0)
{
    <div class="alert alert-info" role="alert">
        A job must be created before a measurement can be created.
    </div>

    <a class="btn btn-primary" href="/jobs/create">
        Create job
    </a>

    <a class="btn btn-secondary" href="/measurements">
        Back to measurements
    </a>
}
else if (_tools.Count == 0)
{
    <div class="alert alert-info" role="alert">
        A tool must be created before a measurement can be created.
    </div>

    <a class="btn btn-primary" href="/tools/create">
        Create tool
    </a>

    <a class="btn btn-secondary" href="/measurements">
        Back to measurements
    </a>
}
else
{
    <EditForm Model="_form"
        OnValidSubmit="CreateMeasurementAsync"
        FormName="create-measurement">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="job-id" class="form-label">
                Job
            </label>

            <InputSelect id="job-id"
                         class="form-select"
                         @bind-Value="_form.JobId">

                <option value="">Select job</option>

                @foreach (var job in _jobs)
                {
                    <option value="@job.Id">
                        @job.JobNumber - @job.Title
                    </option>
                }
            </InputSelect>

            <ValidationMessage For="() => _form.JobId" />
        </div>

        <div class="mb-3">
            <label for="tool-id" class="form-label">
                Tool
            </label>

            <InputSelect id="tool-id"
                         class="form-select"
                         @bind-Value="_form.ToolId">

                <option value="">Select tool</option>

                @foreach (var tool in _tools)
                {
                    <option value="@tool.Id">
                        @tool.Name - @tool.SerialNumber
                    </option>
                }
            </InputSelect>

            <ValidationMessage For="() => _form.ToolId" />
        </div>

        <div class="mb-3">
            <label for="measurement-value" class="form-label">
                Value
            </label>

            <InputNumber id="measurement-value"
                         class="form-control"
                         @bind-Value="_form.Value" />

            <ValidationMessage For="() => _form.Value" />
        </div>

        <div class="mb-3">
            <label for="measurement-unit" class="form-label">
                Unit
            </label>

            <InputText id="measurement-unit"
                       class="form-control"
                           @bind-Value="_form.Unit" />

            <ValidationMessage For="() => _form.Unit" />

        </div>

        <div class="mb-3">
            <label for="measurement-notes" class="form-label">
                Notes
            </label>

            <InputTextArea id="measurement-notes"
                           class="form-control"
                           @bind-Value="_form.Notes" />

            <ValidationMessage For="() => _form.Notes" />

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isSaving">
                @(_isSaving ? "Saving..." : "Create")
            </button>

            <a class="btn btn-secondary" href="/measurements">
                Cancel
            </a>
        </div>
    </EditForm>
}



@code {
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }
    private readonly CreateMeasurementForm _form = new();
    private List<JobOption> _jobs = [];
    private List<ToolOption> _tools = [];
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isSaving;
    private string? _errorMessage;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _jobs = await JobService.GetOptionsAsync(_componentCts.Token);
            _tools = await ToolService.GetOptionsAsync(_componentCts.Token);

            // Used by quality dashboard to select a specific job
            // when clicking button `Add measurement`
            if (JobId.HasValue)
            {
                _form.JobId = JobId.Value;
            }
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (Exception)
        {
            _errorMessage = "Jobs and tools could not be loaded.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task CreateMeasurementAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var measurement = await MeasurementService.CreateAsync(_form, _componentCts.Token);

            NavigationManager.NavigateTo(
                $"/measurements/{measurement.Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The measurement could not be created.";
        }
        finally
        {
            
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
            
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}


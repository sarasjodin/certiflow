@page "/measurements/{Id:guid}/edit"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Measurements
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject NavigationManager NavigationManager
@inject MeasurementService MeasurementService

<PageTitle>Edit measurement</PageTitle>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

@if (_isLoading)
{
    <div class="alert alert-info" role="alert">
        Loading measurement...
    </div>
}
else if (_form is null)
{
    <div class="alert alert-warning" role="alert">
        Measurement not found.
    </div>

    <a class="btn btn-secondary" href="/measurements">
        Back to measurements
    </a>
}
else
{
    <div class="form-container">
        <EditForm Model="_form"
                  OnValidSubmit="UpdateMeasurementAsync"
                  FormName="edit-measurement">

            <DataAnnotationsValidator />
        
                
                <div class="mb-3">
                        <label for="measurement-value" class="form-label">
                            Value
                        </label>

                        <InputNumber id="measurement-value"
                                     class="form-control"
                                     @bind-Value="_form.Value" />

                        <ValidationMessage For="() => _form.Value" />
                </div>

                <div class="mb-3">
                    <label for="measurement-unit" class="form-label">
                        Unit
                    </label>

                    <InputText id="measurement-unit"
                               class="form-control"
                               @bind-Value="_form.Unit" />

                    <ValidationMessage For="() => _form.Unit" />

                </div>

                <div class="mb-3">
                    <label for="measurement-notes" class="form-label">
                        Notes
                    </label>

                    <InputTextArea id="measurement-notes"
                                   class="form-control"
                                   @bind-Value="_form.Notes" />

                    <ValidationMessage For="() => _form.Notes" />

                </div>
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@_isSaving">
                        @(_isSaving ? "Saving..." : "Save changes")
                    </button>

                    <a class="btn btn-secondary"
                       href="@($"/measurements/{Id}")">
                        Cancel
                    </a>
                </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; } // Receives the measurement ID from the URL route
    private EditMeasurementForm? _form;
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _form = await MeasurementService.GetEditFormAsync(Id, _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (Exception)
        {
            _errorMessage = "The measurement could not be loaded.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task UpdateMeasurementAsync()
    {
        if (_form is null)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var updated = await MeasurementService.UpdateAsync(_form, _componentCts.Token);

            if (!updated)
            {
                _errorMessage = "Measurement not found.";
                return;
            }

            NavigationManager.NavigateTo($"/measurements/{Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The measurement could not be updated.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

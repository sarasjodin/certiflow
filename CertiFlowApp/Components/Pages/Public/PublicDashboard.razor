@page "/"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Public
@using CertiFlowApp.Services.DateTime
@using Microsoft.AspNetCore.Components.Authorization
@using CertiFlow.Web.Infrastructure.Identity
@inject TimeProvider TimeProvider
@inject PublicDashboardService PublicDashboardService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home</PageTitle>
<div class="container py-4">

    <h1 class="mb-3">Quality overview</h1>

    <p class="lead mb-4">
        Quality control and measurement management.
    </p>

    <div class="row mb-3">
        <div class="col-md-7">
            <p class="mb-0">
                This public dashboard provides an overview of current quality data.
            </p>
        </div>

        <div class="col-md-5 d-flex justify-content-end">
            <p class="mb-0">
                <em>
                    Log in to manage customers, jobs, tools and measurements.
                </em>
            </p>
        </div>
    </div>

@if (_isLoading)
{
    <p>Loading dashboard...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_dashboard is null)
{
    <div class="alert alert-info" role="alert">
        Dashboard data could not be loaded.
    </div>
}
else
{
    <div class="row g-4 mb-4">        
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted text-uppercase mb-2">
                        Current
                    </div>
                    <h5 class="card-title">Approved jobs</h5>
                    <p class="display-6 mb-0">@_dashboard.ApprovedJobCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted text-uppercase mb-2">
                        Current
                    </div>
                    <h5 class="card-title">Registered measurements</h5>
                    <p class="display-6 mb-0">@_dashboard.MeasurementCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted text-uppercase mb-2">
                        Current
                    </div>
                    <h5 class="card-title">Available tools</h5>
                    <p class="display-6 mb-0">@_dashboard.AvailableToolCount</p>
                </div>
            </div>
        </div>
        <p>
            * Available tools are active tools with a valid calibration.
            Tools that are inactive or have an expired or missing calibration date
            are not counted as available.
        </p>
        <p class="small text-muted text-start mb-4">
            Last updated: @ApplicationDateTime.Format(_lastUpdatedUtc)
        </p>
    </div>
}

@code {
    private PublicDashboardDto? _dashboard;
    private DateTimeOffset? _lastUpdatedUtc;
    
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        // Rrdirect for authenticated and approved users to the quality dashboard
        if (user.Identity?.IsAuthenticated == true)
        {
            var isInternalUser =
                user.IsInRole(ApplicationRoles.Operator) ||
                user.IsInRole(ApplicationRoles.Verifier) ||
                user.IsInRole(ApplicationRoles.Approver) ||
                user.IsInRole(ApplicationRoles.SystemAdmin);

            if (isInternalUser)
            {
                NavigationManager.NavigateTo("/quality/dashboard");
                return;
            }

            NavigationManager.NavigateTo("/account/pending");
            return;
        }
        try
        {
            // Each time this component is initialized, the actual dashboard data is loaded
            // into a new PublicDashboardDto if the user is not authenticated
            _dashboard = await PublicDashboardService.GetPublicAsync();
            _lastUpdatedUtc = TimeProvider.GetUtcNow();
        }
        catch (Exception)
        {
            _errorMessage = "The dashboard could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
</div>


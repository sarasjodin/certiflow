@page "/"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Public
@using CertiFlowApp.Services.DateTime
@using Microsoft.AspNetCore.Components.Authorization
@using CertiFlow.Web.Infrastructure.Identity
@inject TimeProvider TimeProvider
@inject PublicDashboardService PublicDashboardService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home</PageTitle>

<h1>Public Dashboard</h1>
<p>
    Welcome to CertiFlow's public dashboard.
    Here you can view public statistics.
</p>

<p>
    Log in to manage customers, jobs, tools and measurements.
</p>

@if (_isLoading)
{
    <p>Loading dashboard...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_dashboard is null)
{
    <div class="alert alert-info" role="alert">
        Dashboard data could not be loaded.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Approved jobs</th>
                <th>Registered measurements</th>
                <th>Available tools*</th>
            </tr>
        </thead>

        <tbody>
          
            <tr>
                <td>@_dashboard.ApprovedJobCount</td>
                <td>@_dashboard.MeasurementCount</td>
                <td>@_dashboard.AvailableToolCount</td>
            </tr>
           
        </tbody>
    </table>
    <p>
        * Available tools are active tools with a valid calibration.
        Tools that are inactive or have an expired or missing calibration date
        are not counted as available.
    </p>
    <p class="small text-muted text-start">
        Last updated: @ApplicationDateTime.Format(_lastUpdatedUtc)
    </p>
}

@code {
    private PublicDashboardDto? _dashboard;
    private DateTimeOffset? _lastUpdatedUtc;
    
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        // Rrdirect for authenticated and approved users to the quality dashboard
        if (user.Identity?.IsAuthenticated == true)
        {
            var isInternalUser =
                user.IsInRole(ApplicationRoles.Operator) ||
                user.IsInRole(ApplicationRoles.Verifier) ||
                user.IsInRole(ApplicationRoles.Approver) ||
                user.IsInRole(ApplicationRoles.SystemAdmin);

            if (isInternalUser)
            {
                NavigationManager.NavigateTo("/quality/dashboard");
                return;
            }

            NavigationManager.NavigateTo("/account/pending");
            return;
        }
        try
        {
            // Each time this component is initialized, the actual dashboard data is loaded
            // into a new PublicDashboardDto if the user is not authenticated
            _dashboard = await PublicDashboardService.GetPublicAsync();
            _lastUpdatedUtc = TimeProvider.GetUtcNow();
        }
        catch (Exception)
        {
            _errorMessage = "The dashboard could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}


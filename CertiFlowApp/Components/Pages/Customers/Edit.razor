@page "/customers/{Id:guid}/edit"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject CustomerService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>Edit customer</PageTitle>

@if (_isLoading)
{
    <p>Loading customer...</p>
}
else if (_form is null)
{
    <div class="alert alert-warning" role="alert">
        Customer not found.
    </div>

    <a class="btn btn-secondary" href="/customers">
        Back to customers
    </a>
}
else
{
    <h1>Edit customer</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <EditForm Model="_form"
              OnValidSubmit="UpdateCustomerAsync"
              FormName="edit-customer">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="customer-name" class="form-label">
                Customer name
            </label>

            <InputText id="customer-name"
                       class="form-control"
                       @bind-Value="_form.Name" />

            <ValidationMessage For="() => _form.Name" />
        </div>

        <div class="mb-3">
            <label for="organization-number" class="form-label">
                Organization number
            </label>

            <InputText id="organization-number"
                       class="form-control"
                       @bind-Value="_form.OrganizationNumber" />

            <ValidationMessage For="() => _form.OrganizationNumber" />
        </div>

        <div class="d-flex gap-2">


            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isSaving">
                @(_isSaving ? "Saving..." : "Save changes")
            </button>

            <a class="btn btn-secondary"
               href="@($"/customers/{Id}")">
                Cancel
            </a>

        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; } // Receives the customer ID from the URL route
    private EditCustomerForm? _form;
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _form = await CustomerService.GetEditFormAsync(
                Id,
                _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task UpdateCustomerAsync()
    {
        if (_form is null)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var updated = await CustomerService.UpdateAsync(
                _form,
                _componentCts.Token);

            if (!updated)
            {
                _errorMessage = "Customer not found.";
                return;
            }

            NavigationManager.NavigateTo($"/customers/{Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The customer could not be updated.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

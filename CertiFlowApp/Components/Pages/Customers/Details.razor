@page "/customers/{Id:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using Microsoft.AspNetCore.Authorization
@using CertiFlowApp.Services.DateTime
@attribute [Authorize(Policy = "InternalUser")]
@inject CustomerService CustomerService

<PageTitle>Customer details</PageTitle>

@if (_isLoading)
{
    <p>Loading customer...</p>
}
else if (_customer is null)
{
    <div class="alert alert-warning" role="alert">
        Customer not found.
    </div>

    <a class="btn btn-secondary" href="/customers">
        Back to customers
    </a>
}
else
{
    <h1>@_customer.Name</h1>

    <dl class="row">
        <dt class="col-sm-3">Organization number</dt>
        <dd class="col-sm-9">@_customer.OrganizationNumber</dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@ApplicationDateTime.Format(_customer.CreatedAtUtc)</dd>

        <dt class="col-sm-3">Created by</dt>
        <dd class="col-sm-9">@_customer.CreatedByUserName</dd>

        <dt class="col-sm-3">Last updated</dt>
        <dd class="col-sm-9">
            @if (_customer.UpdatedAtUtc.HasValue)
            {
                <span>
                    @ApplicationDateTime.Format(_customer.UpdatedAtUtc)
                </span>
            }
            else
            {
                <span>Not updated</span>
            }
        </dd>

        <dt class="col-sm-3">Jobs</dt>
        <dd class="col-sm-9">@_customer.JobCount</dd>
    </dl>

    <div class="d-flex gap-2">
        <a class="btn btn-primary"
           href="@($"/customers/{_customer.Id}/edit")">
            Edit
        </a>

        <a class="btn btn-danger"
           href="@($"/customers/{_customer.Id}/delete")">
            Delete
        </a>

        <a class="btn btn-secondary" href="/customers">
            Back to customers
        </a>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; } // Receives the customer ID from the URL route
    private CustomerDetailsModel? _customer; // Customer details model to hold the customer information
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _customer = await CustomerService.GetByIdAsync(
                Id,
                _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

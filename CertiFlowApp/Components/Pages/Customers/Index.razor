@page "/customers"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using CertiFlowApp.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject CustomerService CustomerService

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<p>
    <a class="btn btn-primary" href="/customers/create">
        Create customer
    </a>
</p>

@if (_isLoading)
{
    <p>Loading customers...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_customers.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No customers have been created.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Organization number</th>
                <th>Created</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var customer in _customers)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.OrganizationNumber</td>
                    <td>@customer.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/customers/{customer.Id}")">
                                Details
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="@($"/customers/{customer.Id}/edit")">
                                Edit
                            </a>

                            <a class="btn btn-sm btn-outline-danger"
                               href="@($"/customers/{customer.Id}/delete")">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Customer> _customers = [];
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            _customers = await CustomerService.GetAllAsync(_componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected when the component is disposed.
        }
        catch (Exception)
        {
            _errorMessage = "The customers could not be loaded.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

@page "/customers/create"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject CustomerService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>Create customer</PageTitle>

<h1>Create customer</h1>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<div class="form-container">
    <EditForm Model="_form"
              OnValidSubmit="CreateCustomerAsync"
              FormName="create-customer">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="customer-name" class="form-label">
                Customer name
            </label>

            <InputText id="customer-name"
                       class="form-control"
                       @bind-Value="_form.Name" />

            <ValidationMessage For="() => _form.Name" />
        </div>

        <div class="mb-3">
            <label for="organization-number" class="form-label">
                Organization number
            </label>

            <InputText id="organization-number"
                       class="form-control"
                       @bind-Value="_form.OrganizationNumber" />

            <ValidationMessage For="() => _form.OrganizationNumber" />
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Create")
        </button>

        <a class="btn btn-secondary" href="/customers">
            Cancel
        </a>
    </EditForm>
</div>

@code {
    private readonly CreateCustomerForm _form = new();
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isSaving;
    private string? _errorMessage;

    private async Task CreateCustomerAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var customer = await CustomerService.CreateAsync(
                _form,
                _componentCts.Token);

            NavigationManager.NavigateTo(
                $"/customers/{customer.Id}");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The customer could not be created.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isSaving = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

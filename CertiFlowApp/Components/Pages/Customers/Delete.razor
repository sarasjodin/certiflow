@page "/customers/{Id:guid}/delete"
@rendermode InteractiveServer
@using CertiFlowApp.Features.Customers
@using CertiFlowApp.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject CustomerService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>Delete customer</PageTitle>

@if (_isLoading)
{
    <p>Loading customer...</p>
}
else if (_customer is null)
{
    <div class="alert alert-warning" role="alert">
        Customer not found.
    </div>

    <a class="btn btn-secondary" href="/customers">
        Back to customers
    </a>
}
else
{
    <h1>Delete customer</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this customer?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@_customer.Name</dd>

        <dt class="col-sm-3">Organization number</dt>
        <dd class="col-sm-9">@_customer.OrganizationNumber</dd>

        <dt class="col-sm-3">Related jobs</dt>
        <dd class="col-sm-9">@_customer.Jobs.Count</dd>
    </dl>

    @if (_customer.Jobs.Count > 0)
    {
        <div class="alert alert-info" role="alert">
            This customer cannot be deleted because it has related jobs.
        </div>
    }

    <div class="d-flex gap-2">

        <button type="button"
                class="btn btn-danger"
                disabled="@(_isDeleting || _customer.Jobs.Count > 0)"
                @onclick="DeleteCustomerAsync">
            @(_isDeleting ? "Deleting..." : "Delete")
        </button>

        <a class="btn btn-secondary"
           href="@($"/customers/{Id}")">
            Cancel
        </a>

    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Customer? _customer;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _customer = await CustomerService.GetByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteCustomerAsync()
    {
        _isDeleting = true;
        _errorMessage = null;

        try
        {
            var deleted = await CustomerService.DeleteAsync(Id);

            if (!deleted)
            {
                _errorMessage = "Customer not found.";
                return;
            }

            NavigationManager.NavigateTo("/customers");
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The customer could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
@page "/customers/{Id:guid}/delete"
@rendermode InteractiveServer
@implements IDisposable
@using CertiFlowApp.Features.Customers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "InternalUser")]
@inject CustomerService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>Delete customer</PageTitle>

@if (_isLoading)
{
    <p>Loading customer...</p>
}
else if (_customer is null)
{
    <div class="alert alert-warning" role="alert">
        Customer not found.
    </div>

    <a class="btn btn-secondary" href="/customers">
        Back to customers
    </a>
}
else
{
    <h1>Delete customer</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    @if (_customer.JobCount > 0)
    {
        <div class="alert alert-info" role="alert">
            This customer cannot be deleted because it has related jobs.
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Are you sure you want to delete this customer?
        </div>
    }
<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@_customer.Name</dd>

    <dt class="col-sm-3">Organization number</dt>
    <dd class="col-sm-9">@_customer.OrganizationNumber</dd>

    <dt class="col-sm-3">Related jobs</dt>
    <dd class="col-sm-9">@_customer.JobCount</dd>
</dl>

<div class="d-flex gap-2">
    @if (_customer.JobCount == 0)
    {
        <button type="button"
            class="btn btn-danger"
            disabled="@(_isDeleting || _customer.JobCount > 0)"
            @onclick="DeleteCustomerAsync">
            @(_isDeleting ? "Deleting..." : "Delete")
        </button>
    }
    <a class="btn btn-secondary"
        href="@($"/customers/{Id}")">
        Cancel
    </a>
</div>
}

@code {
    [Parameter] 
    public Guid Id { get; set; } // Receives the customer ID from the URL route
    private CustomerDetailsModel? _customer; // Customer details model to hold the customer information
    private readonly CancellationTokenSource _componentCts = new();
    private bool _isLoading;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _customer = await CustomerService.GetByIdAsync(
                Id,
                _componentCts.Token);
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected cancellation when the component is disposed.
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task DeleteCustomerAsync()
    {
        _isDeleting = true;
        _errorMessage = null;

        try
        {
            var deleted = await CustomerService.DeleteAsync(
                Id,
                _componentCts.Token);

            if (!deleted)
            {
                _errorMessage = "Customer not found.";
                return;
            }

            NavigationManager.NavigateTo("/customers");
        }
        catch (OperationCanceledException)
            when (_componentCts.IsCancellationRequested)
        {
            // Expected when the component is disposed
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (Exception)
        {
            _errorMessage = "The customer could not be deleted.";
        }
        finally
        {
            if (!_componentCts.IsCancellationRequested)
            {
                _isDeleting = false;
            }
        }
    }

    public void Dispose()
    {
        _componentCts.Cancel();
        _componentCts.Dispose();
    }
}

@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold fs-3 text-decoration-none" href="">CertiFlow</a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="flex-column">

        <AuthorizeView>
            <Authorized>

                <div class="nav-section-title px-3">
                    Quality
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="quality/dashboard">
                        <span class="bi bi-speedometer2-nav-menu"
                              aria-hidden="true"></span>
                        Quality Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="jobs">
                        <span class="bi bi-briefcase-nav-menu"
                              aria-hidden="true"></span>
                        Jobs
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tools">
                        <span class="bi bi-wrench-adjustable-nav-menu"
                              aria-hidden="true"></span>
                        Tools
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="measurements">
                        <span class="bi bi-value-nav-menu"
                              aria-hidden="true"></span>
                        Measurements
                    </NavLink>
                </div>

                <div class="nav-section-title px-3">
                    Administration
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="customers">
                        <span class="bi bi-people-fill-nav-menu"
                              aria-hidden="true"></span>
                        Customers
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

    </nav>
</div>

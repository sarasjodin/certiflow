@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<AuthorizeView>
    <Authorized Context="authContext">

        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main class="main-layout">
                <div class="top-row px-4 d-flex justify-content-end align-items-center">

                    <span>
                        Welcome, @authContext.User.Identity?.Name
                    </span>

                    <form method="post" action="/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link">
                            Logout
                        </button>
                    </form>
                
                </div>

                <article class="main-content px-4">
                    @Body
                </article>

                <footer class="small text-muted text-end px-4 py-2 mt-auto">
                    CertiFlow v@(Configuration["AppInfo:Version"]) · @Environment.EnvironmentName
                </footer>
            </main>
        </div>
    </Authorized>

    <NotAuthorized>
        <main class="main-layout d-flex flex-column min-vh-100">
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <a class="navbar-brand certiflow-brand fw-bold fs-3 text-decoration-none"
                   href="/">
                    CertiFlow
                </a>

                <a class="btn btn-primary"
                   href="/Identity/Account/Login">
                    Login
                </a>
            </div>

            <article class="main-content px-4">
                @Body
            </article>

            <footer class="small text-muted text-end px-4 py-2 mt-auto">
                CertiFlow v@(Configuration["AppInfo:Version"]) · @Environment.EnvironmentName
            </footer>
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

                <mxCell id="249" value="&lt;ul&gt;&lt;li&gt;Användaren är samma person över tid.&lt;/li&gt;&lt;li&gt;Roll/Tillhörighet är tidsbunden.&lt;/li&gt;&lt;li&gt;UserID och AssignmentID ska då sparas på viktiga händelser.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Behörighet ska kontrolleras mot &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot; data-end=&quot;1447&quot; data-start=&quot;1416&quot;&gt;nuvarande aktiva assignment&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;.&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Historik ska visas från &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot; data-end=&quot;1518&quot; data-start=&quot;1474&quot;&gt;assignment som gällde när datan skapades&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Kritiska data uppdateras inte “på plats”. Ändringar skapar ny auditlogg, eventuell ny status eller ny version.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1960" y="566" width="630" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="260" value="&lt;ul&gt;&lt;li&gt;DeletedAt&lt;/li&gt;&lt;li&gt;DeletedByUserId&lt;/li&gt;&lt;li&gt;Version&lt;/li&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="-4" width="150" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="273" value="Eventuell ny version blir nytt certifikat" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">

                </mxCell>
                <mxCell id="275" value="Nya rader eller auditlogg vid ändring,&lt;div&gt;inte bara skriva över värdet.&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
